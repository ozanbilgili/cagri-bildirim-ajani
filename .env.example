# --- Dil modeli (OpenAI uyumlu herhangi bir uç nokta) ---
# Yerel Ollama (varsayılan, API anahtarı gerekmez):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=yerel
LLM_MODEL=gemma4:26b
# Ollama'da düşünme modunu kapatır; desteklemeyen sağlayıcılarda boş bırakın.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# Bulut sağlayıcı örneği (OpenAI uyumlu):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
# LLM_REASONING_EFFORT=

# --- Embedding (kural kitabı RAG) ---
EMBEDDING_MODEL=bge-m3
# Boşsa LLM_BASE_URL kullanılır
EMBEDDING_BASE_URL=

# --- Konuşma tanıma (opsiyonel, requirements-asr.txt) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- Ajan davranışı ---
MAX_AJAN_ADIMI=5
MAX_REVIZYON=1
DUSUK_GUVEN_ESIGI=60

# --- Depolama ---
VERI_DIZINI=data
HAFIZA_DB=data/hafiza.db
